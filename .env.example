# Copy this file as .env and fill in the values. .env NEVER goes into the repo.

# Slack bot token (xoxb-...). Only the person who runs the message sync has it.
SLACK_BOT_TOKEN=

# Channels the assistant reads (allow list), as Slack channel IDs, comma separated (e.g. C0123ABCDEF,C0456GHIJKL).
# A channel that is not on the list is not read; a channel name never allows a channel. Empty = no channel is read.
# Where to find a channel ID in Slack: click the channel name -> channel details -> "Channel ID" at the bottom;
# or, in the browser while the channel is open, the last part of the address.
ALLOWED_CHANNELS=

# Channels that are never read, as Slack channel IDs (write the IDs of HR, finance and similar channels here).
# This list always wins over ALLOWED_CHANNELS. A value that is not a channel ID stops the sync and seed commands.
BLOCKED_CHANNELS=

# AI provider: gemini or fake (tests always run with fake)
AI_PROVIDER=fake

# Free Gemini key you got with your own Google account
GEMINI_API_KEY=

# Database file
DATABASE_PATH=server/agentstack.db

# Address(es) where the frontend runs; the server accepts browser requests only from here
FRONTEND_ORIGINS=http://localhost:5173

GEMINI_MODEL=

AI_TIMEOUT_SECONDS=30
