# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env repoya GİRMEZ.

# Slack bot token'ı (xoxb-...). Yalnızca mesaj çekmeyi çalıştıran kişide olur.
SLACK_BOT_TOKEN=

# Asistanın okuyacağı kanallar (izin listesi). Listede olmayan kanal okunmaz.
IZINLI_KANALLAR=genel,dev,yonetim

# Yapay zekâ sağlayıcısı: gemini ya da sahte (testler her zaman sahte ile çalışır)
AI_SAGLAYICI=sahte

# Kendi Google hesabınla aldığın ücretsiz Gemini anahtarı
GEMINI_API_KEY=

# Veritabanı dosyası
VERITABANI_YOLU=server/agentstack.db

# Arayüzün çalıştığı adres(ler); sunucu yalnızca buradan gelen tarayıcı isteklerini kabul eder
ARAYUZ_ADRESLERI=http://localhost:5173
